+/// carte Ice en main.
+fn x_fusion(v: &Vue) -> Option<u32> {
+    let c = v.ma_carte_sur_la_pile()?;
+    if v.carte(c).name != "Ice Eternal" {
+        return None;
+    }
+    let ice = |id: fab_engine::ObjectId| v.carte(id).supertypes.has(fab_engine::Supertypes::ICE);
+    let garde = v
+        .ma_main()
+        .iter()
+        .filter(|&&x| ice(x))
+        .min_by_key(|&&x| v.carte(x).pitch_value())?;
+    let total: u32 = v
+        .ma_main()
+        .iter()
+        .filter(|&&x| x != *garde)
+        .map(|&x| v.carte(x).pitch_value() as u32)
+        .sum::<u32>()
+        + v.points_de_ressource() as u32;
+    Some(total / 2)
+}
